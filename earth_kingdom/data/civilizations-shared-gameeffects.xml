<?xml version="1.0" encoding="utf-8"?>
<GameEffects xmlns="GameEffects">
	<!-- ==================================================	-->
	<!--	Civ-Specific Traits							-->
	<!-- ==================================================	-->
	<!-- EARTH_KINGDOM -->
	<Modifier id="TRAIT_MOD_HUNDRED_YEARS_WAR_SETTLEMENT_CAP" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_ADJUST_SETTLEMENT_CAP" run-once="false" permanent="true">
		<OwnerRequirements>
			<Requirement type="REQUIREMENT_PLAYER_DECLARED_WAR">
				<Argument name="DeclaredByOwner">false</Argument>
				<Argument name="DeclaredByOpponent">true</Argument>
				<Argument name="FirstWarDeclaredOnPlayer">false</Argument>
			</Requirement>
		</OwnerRequirements>
		<Argument name="Amount">1</Argument>
	</Modifier>
	<Modifier id="TRAIT_MOD_HUNDRED_YEARS_WAR_EXPENSIVE_SETTLER_WAR" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_UNIT_PRODUCTION">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_PLAYER_HAS_X_WARS">
				<Argument name="Amount">1</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="Percent">-50</Argument>
		<Argument name="UnitType">UNIT_SETTLER</Argument>
	</Modifier>
	<Modifier id="TRAIT_MOD_HUNDRED_YEARS_WAR_CHEAP_SETTLER_PEACE" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_UNIT_PRODUCTION">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_PLAYER_HAS_X_WARS" inverse="true">
				<Argument name="Amount">1</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="Percent">50</Argument>
		<Argument name="UnitType">UNIT_SETTLER</Argument>
	</Modifier>
	<!--<Modifier id="TRAIT_MOD_HUNDRED_YEARS_WAR_FOOD_ADJACENCY" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ACTIVATE_CONSTRUCTIBLE_ADJACENCY">
		<Argument name="ConstructibleAdjacency">TheWorldsFarmFood</Argument>
		<Argument name="Tooltip">LOC_TRAIT_EARTH_KINGDOM_ABILITY_NAME</Argument>
	</Modifier>-->
	<Modifier id="TRAIT_MOD_HUNDRED_YEARS_WAR_FOOD_CONNECTED" collection="COLLECTION_ALL_CITIES" effect="EFFECT_CITY_ADJUST_YIELD_PER_CONNECTED_CITY">
		<Argument name="YieldType">YIELD_FOOD</Argument>
		<Argument name="Amount" type="ScaleByGameAge" extra="100">2</Argument>
	</Modifier>
	<Modifier id="TRAIT_MOD_HUNDRED_YEARS_WAR_HAPPINESS_CONNECTED" collection="COLLECTION_ALL_CITIES" effect="EFFECT_CITY_ADJUST_YIELD_PER_CONNECTED_CITY">
		<Argument name="YieldType">YIELD_HAPPINESS</Argument>
		<Argument name="Amount" type="ScaleByGameAge" extra="100">2</Argument>
	</Modifier>
</GameEffects>